# =========================================================

# DEPENDENCIES

# =========================================================

node_modules/
**/node_modules/

# =========================================================

# PRODUCTION / BUILD OUTPUT

# =========================================================

dist/
dist-ssr/
build/
coverage/
.vite/

# =========================================================

# ENVIRONMENT VARIABLES / SECRETS

# =========================================================

.env
.env.*
**/.env
**/.env.*

# Allow safe example environment files

!.env.example
!.env.example.*
!**/.env.example
!**/.env.example.*

# =========================================================

# LOGS

# =========================================================

logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================================================

# LOCAL / TEMPORARY FILES

# =========================================================

*.local
*.tmp
*.temp
*.cache

.DS_Store
Thumbs.db
Desktop.ini

$RECYCLE.BIN/

# =========================================================

# EDITORS / IDEs

# =========================================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/

*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.sln
*.sw?

# =========================================================

# BACKEND GENERATED FILES

# =========================================================

uploads/
temp/
tmp/

# Local database files

*.sqlite
*.sqlite3
*.db

# =========================================================

# TEST / DEBUG OUTPUT

# =========================================================

.nyc_output/
*.pid
*.seed
*.pid.lock
test-results/
playwright-report/
allure-results/

# =========================================================

# SECURITY / CREDENTIAL FILES

# =========================================================

# Private keys / certificates

*.pem
*.key
*.crt
*.p12
*.pfx

# Service account credentials

*-service-account.json
service-account.json
credentials.json

# Firebase / Google credentials

firebase-key.json
google-credentials.json

# =========================================================

# DEPLOYMENT / PLATFORM FILES

# =========================================================

.vercel/
.netlify/

# =========================================================

# BACKUPS

# =========================================================

*.bak
*.backup
*.old
~
EOF